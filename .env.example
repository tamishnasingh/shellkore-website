# Postgres connection string (Vercel → Storage → Neon). Leave empty locally to use the built-in dev database.
DATABASE_URL=

# Password for /admin. Use a long, unique passphrase.
ADMIN_PASSWORD=

# At least 32 random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# AI assistant (console.anthropic.com). Without it, the assistant answers from the FAQ.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: email alert for each waitlist signup via Resend (resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=Shellkore <waitlist@your-verified-domain.com>

# Public site URL, used for SEO tags and the sitemap
NEXT_PUBLIC_SITE_URL=https://shellkore.com
